# Copy this file to .env and fill in real values. Never commit .env.

# From the Dev Dashboard app "Create a version" screen / app settings.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Your store's .myshopify.com domain, e.g. threads-of-creation.myshopify.com
SHOPIFY_SHOP=

# Same value as application_url in shopify.app.toml, no trailing slash.
HOST=https://REPLACE_ME_BACKEND_URL

# From app.fashn.ai -> Developer API -> API Keys (requires API credits
# topped up first -- separate from any FASHN app credits you may have).
FASHN_API_KEY=

# Local port for `npm start`. Your host (Render/Railway) will usually
# override this with its own PORT env var automatically.
PORT=3000
