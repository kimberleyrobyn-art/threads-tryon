{
  "productType": "Clothes",
  "aspectRatio": "1:1",

  "inputDir": "./input",
  "outputDir": "./output",

  "watch": true,
  "watchIntervalMs": 15000,

  "delayBetweenPhotosMs": 3000,
  "generateTimeoutMs": 180000,

  "autoStyling": true,
  "styling": {
    "model": { "mode": "fixed", "index": 0, "count": 9 },
    "pose": { "mode": "cycle", "index": 0, "count": 6 },
    "background": { "mode": "fixed", "index": 0, "count": 9 }
  }
}
